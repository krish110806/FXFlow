# FXFlow — Environment Configuration
# Copy this file to .env and fill in your values

# ─── Database ────────────────────────────────────────────────────────
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=fxflow
POSTGRES_USER=fxflow_user
POSTGRES_PASSWORD=CHANGE_ME_TO_A_STRONG_PASSWORD

# ─── Frankfurter API ─────────────────────────────────────────────────
FRANKFURTER_BASE_URL=https://api.frankfurter.dev/v2

# ─── Pipeline Settings ───────────────────────────────────────────────
# Default base currency for ingestion
DEFAULT_BASE_CURRENCY=USD

# Comma-separated list of quote currencies to track
TRACKED_CURRENCIES=EUR,GBP,JPY,CHF,CAD,AUD,CNY,INR,BRL,MXN

# How many days of history to backfill on first run
INITIAL_BACKFILL_DAYS=365

# Rolling volatility window (business days)
VOLATILITY_WINDOW=20

# ─── Logging ──────────────────────────────────────────────────────────
LOG_LEVEL=INFO
LOG_DIR=logs
